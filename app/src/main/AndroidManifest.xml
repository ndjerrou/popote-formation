<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permission "normale" : accordée à l'installation, pas de popup -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Permission "dangereuse" (Android 13+) : déclarée ici ET demandée à l'exécution -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".PopoteApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Popote">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Activité secondaire (démo Views XML) : non exportée, thème AppCompat requis -->
        <activity
            android:name=".legacy.XmlDemoActivity"
            android:exported="false"
            android:label="@string/xml_demo"
            android:theme="@style/Theme.AppCompat.DayNight.DarkActionBar" />
    </application>

</manifest>
